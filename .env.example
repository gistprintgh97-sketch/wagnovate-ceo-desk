# Copy this file to ".env" for your own computer. On Render you type these values in the dashboard instead.
# NEVER commit the real .env file. Generate secrets with:  pnpm secrets   (use DIFFERENT values for production)

# ---- Database (local docker database runs on port 5433; Render fills this in automatically) ----
DATABASE_URL="postgresql://wagnovate:wagnovate_dev_password@localhost:5433/ceo_desk?schema=public"

# ---- Public address of the app: used for the origin check and password-reset links ----
# Local: http://localhost:3000      Production: https://ceo.wagnovate.com  (https, no trailing slash)
APP_URL="http://localhost:3000"

# ---- Secrets (run: pnpm secrets) ----
AUTH_SECRET=""            # 32+ characters. Peppers login-session storage. Required in production.
SETUP_TOKEN=""            # one-time password for creating the CEO account at /setup
CRON_SECRET=""            # protects POST /api/cron/reminders
ENCRYPTION_KEY=""         # 64 hex characters. Encrypts the AI key saved in Settings.

# ---- Push notifications (run: pnpm vapid) ----
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:ceo@wagnovate.com"

# ---- Optional ----
AI_API_KEY=""             # fallback AI key (you can instead save one in Settings; "none" = not used)
SMTP_HOST=""              # without SMTP, password-reset emails are not sent (use pnpm admin:reset-password)
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="WAGNOVATE CEO Desk <no-reply@wagnovate.com>"

# ---- Files ----
# Local: a folder inside the project. Render: the persistent disk (/var/data/uploads), set in render.yaml.
UPLOAD_DIR="./storage/uploads"
BACKUP_DIR="./backups"

# ---- Production only (render.yaml sets these) ----
# TRUST_PROXY_HOPS="1"                 how many trusted proxies are in front of the app (Render = 1)
# DISABLE_INTERNAL_SCHEDULER="true"    an external cron job triggers reminders instead of the built-in timer
# TZ="Africa/Accra"
