# ---- Database (docker compose db runs on port 5433) ----
DATABASE_URL="postgresql://wagnovate:wagnovate_dev_password@localhost:5433/ceo_desk?schema=public"

# ---- Public address of the app (used in password-reset links and origin checks) ----
APP_URL="http://localhost:3000"

# ---- First-time admin setup: you must type this token on /setup. Make it long and random. ----
SETUP_TOKEN="change-me-to-a-long-random-string"

# ---- 64 hex characters. Encrypts the AI API key stored in the database. Run: pnpm secrets ----
APP_ENCRYPTION_KEY=""

# ---- Protects POST /api/cron/reminders (for an external cron service). Run: pnpm secrets ----
CRON_SECRET=""

# ---- Optional: email for password-reset links. Without it, the link is printed in the server console. ----
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="WAGNOVATE CEO Desk <no-reply@wagnovate.com>"

# ---- Optional: background push notifications. Run: pnpm vapid ----
VAPID_PUBLIC_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:ceo@wagnovate.com"

# ---- Where uploaded files are stored (outside the public folder) ----
UPLOAD_DIR="./storage/uploads"
